# 카카오 디벨로퍼스 https://developers.kakao.com
# 플랫폼 > Redirect URI: http://localhost:3000/api/auth/kakao/callback
# 동의 항목: 카카오톡 메시지 전송(talk_message), 닉네임
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# 공공데이터포털 > 국토교통부_(TAGO)_열차정보
# https://www.data.go.kr/data/15098552/openapi.do
TAGO_SERVICE_KEY=

# 열차 단위 조회는 코레일이 자동화를 막는 경우가 많아 기본은 공개 시간대 현황만 사용합니다.
# KTX_TRAIN_SEARCH=1
